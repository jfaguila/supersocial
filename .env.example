# ─────────────────────────────────────────────────────────────
# SuperSocial — Variables de entorno
# ─────────────────────────────────────────────────────────────
# 1. Copia este fichero:  cp .env.example .env
# 2. Rellena los valores  (los marcados con * son obligatorios)
# 3. Arranca el sistema:  docker compose up -d
# 4. Abre el panel:       http://localhost:8000
# ─────────────────────────────────────────────────────────────
# IMPORTANTE: Nunca subas el fichero .env a Git.


# ── BASE DE DATOS * ───────────────────────────────────────────
# Docker Compose crea esta base de datos automáticamente.
DATABASE_URL=postgresql+asyncpg://supersocial:changeme@postgres:5432/supersocial
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# ── REDIS * ───────────────────────────────────────────────────
# Docker lo crea automáticamente.
REDIS_URL=redis://redis:6379/0


# ── INTELIGENCIA ARTIFICIAL * ─────────────────────────────────
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Fallback si OpenAI falla (opcional)
# Obtén tu clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=


# ── GENERACIÓN DE VÍDEO ───────────────────────────────────────

# Runway Gen-3 — genera los clips de vídeo por IA (~$15/mes)
# Regístrate en: https://runwayml.com → Settings → API Keys
RUNWAYML_API_KEY=

# ElevenLabs — genera la voz en off automática (~$5/mes)
# Regístrate en: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=

# ID de voz a usar (deja vacío para la voz por defecto)
# Elige tu voz en: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=


# ── TWITTER / X ───────────────────────────────────────────────
# Crea tu app en: https://developer.twitter.com/en/portal
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=


# ── TIKTOK ────────────────────────────────────────────────────
# Solicita acceso en: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=


# ── LINKEDIN ─────────────────────────────────────────────────
# Crea tu app en: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:...


# ── INSTAGRAM ────────────────────────────────────────────────
# Necesitas cuenta Business conectada a una página de Facebook.
# Crea tu app en: https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# ── CONFIGURACIÓN DE GEORGE ───────────────────────────────────

GEORGE_ENV=production
GEORGE_LOG_LEVEL=INFO
GEORGE_MAX_RETRIES=3
GEORGE_RETRY_BASE_SECONDS=2

# full  = George publica automáticamente sin pedir permiso
# semi  = George genera el contenido y tú lo apruebas desde el panel
GEORGE_CYCLE_MODE=semi

# Tu nicho de contenido (separado por comas)
# Opciones: artificial_intelligence, entrepreneurship, financial_freedom,
#           network_marketing, marketing, technology, business, anti_system
CONTENT_NICHES=artificial_intelligence,entrepreneurship

# Idioma del contenido (es = español, en = inglés)
CONTENT_LANGUAGES=es

# Posts máximos por plataforma al día (recomendado: 2-3)
MAX_POSTS_PER_PLATFORM_PER_DAY=3


# ── YOUTUBE FACTORY ─────────────────────────────────────────
# Activa la fábrica de canales de YouTube
YOUTUBE_ENABLED=false

# Proveedor de imágenes: dalle3 (mejor calidad) o flux (más barato)
YOUTUBE_IMAGE_PROVIDER=dalle3

# Producciones simultáneas máximas (2 recomendado)
YOUTUBE_MAX_CONCURRENT_PRODUCTIONS=2

# Estado de privacidad inicial: unlisted (recomendado) o public
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Replicate API — necesario solo si usas Flux como proveedor de imágenes
# Regístrate en: https://replicate.com → Account → API Tokens
REPLICATE_API_TOKEN=

# NOTA: Las credenciales de YouTube (Google OAuth2) se configuran
# POR CANAL en la base de datos (tabla youtube_channels).
# Necesitas crear un proyecto en Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
# Habilita: YouTube Data API v3
# Crea credenciales OAuth2 (tipo Desktop App)
# Obtén el refresh_token usando el flujo OAuth2 offline.


# ── ALERTAS POR EMAIL (opcional) ─────────────────────────────
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
