# =====================================================
# SuperSocial — Environment Configuration Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://supersocial:changeme@postgres:5432/supersocial
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...

# --- X (Twitter) API v2 ---
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:...

# --- Instagram Graph API ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Agent Config ---
GEORGE_ENV=production                        # production | staging | dev
GEORGE_CYCLE_MODE=full                       # full | semi (semi = pause before publish)
GEORGE_LOG_LEVEL=INFO
GEORGE_MAX_RETRIES=3
GEORGE_RETRY_BASE_SECONDS=2

# --- Content Config ---
CONTENT_NICHES=entrepreneurship,financial_freedom,network_marketing,anti_system
CONTENT_LANGUAGES=en
MAX_POSTS_PER_PLATFORM_PER_DAY=3

# --- Notification ---
ALERT_EMAIL=operator@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
