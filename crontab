# SuperSocial George — Cron Schedule (UTC)
# ──────────────────────────────────────────

# Weekly full cycle: every Sunday at 00:00 UTC
0 0 * * 0 docker exec supersocial_george python -m scheduler.weekly_cycle >> /var/log/george_weekly.log 2>&1

# Daily micro cycle: every day at 06:00 UTC
0 6 * * * docker exec supersocial_george python -m scheduler.daily_cycle >> /var/log/george_daily.log 2>&1
